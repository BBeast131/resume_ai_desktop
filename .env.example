# Resume AI desktop — configuration.
# Copy this file to `.env` (same folder) and fill in the two Supabase values.
#
# Every value here is PUBLIC. They are the same ones the web app ships to every
# browser. NEVER put a Supabase service-role / secret key, a Groq key or any
# other server secret in this file: the desktop app does not need them and
# refuses a secret key if it finds one.

# The web app this desktop app talks to.
WEB_APP_URL=https://beastresumebuilder.vercel.app

# Copy these two from the web project. They are the web app's
#   NEXT_PUBLIC_SUPABASE_URL              -> SUPABASE_URL
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY  -> SUPABASE_PUBLISHABLE_KEY
# You can read them in Vercel (Project → Settings → Environment Variables) or in
# Supabase (Project Settings → API → Project URL, and the "publishable" / "anon" key).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Sites the Job Search home buttons may open (comma separated).
JOB_SEARCH_ALLOWED_HOSTS=jobright.ai,hiring.cafe,hiringcafe.com

# Automation mode: seconds to wait before each step continues (1–30). Also in Settings.
AUTOMATION_STEP_SECONDS=5

# Minutes between automatic syncs (5–720). Also in Settings.
SYNC_INTERVAL_MINUTES=30

# How long to wait for one ChatGPT reply, in seconds (9 minutes).
CHATGPT_REPLY_TIMEOUT_SECONDS=540
